<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_white_label_dashboard" model="ir.actions.client">
        <field name="name">White Label</field>
        <field name="tag">white_label_kit.dashboard</field>
    </record>

    <record id="action_home_dashboard" model="ir.actions.client">
        <field name="name">Home</field>
        <field name="tag">white_label_kit.home_dashboard</field>
    </record>

    <menuitem id="menu_white_label" name="White Label" parent="base.menu_administration" sequence="90"
              action="action_white_label_dashboard" groups="base.group_system"/>

    <record id="white_label_kit_config_view_form" model="ir.ui.view">
        <field name="name">white.label.config.form</field>
        <field name="model">white.label.config</field>
        <field name="arch" type="xml">
            <form string="White Label">
                <sheet>
                    <div class="oe_title"><h1><field name="brand_name"/></h1></div>
                    <group>
                        <field name="enabled" widget="boolean_toggle"/>
                    </group>
                    <group>
                        <group string="Identity">
                            <field name="brand_website" widget="url"/>
                            <field name="support_url" widget="url"/>
                            <field name="color"/>
                            <field name="color_navbar"/>
                            <field name="logo" widget="image" class="oe_avatar"/>
                            <field name="app_icon" widget="image" class="oe_avatar"/>
                            <field name="bot_name"/>
                            <field name="bot_avatar" widget="image" class="oe_avatar"/>
                        </group>
                        <group string="Options">
                            <field name="powered_by"/>
                            <field name="replace_texts"/>
                            <field name="cleanup_user_menu"/>
                            <field name="hide_db_manager_link"/>
                            <field name="debrand_emails"/>
                            <field name="hide_enterprise_upsell"/>
                            <field name="hide_documentation"/>
                            <field name="replace_about"/>
                            <field name="debrand_bot"/>
                        </group>
                        <group string="Home screen">
                            <field name="home_dashboard"/>
                            <field name="home_greeting"/>
                            <field name="home_style"/>
                            <field name="home_background" widget="image"/>
                            <field name="home_logo_position"/>
                            <field name="home_logo_size"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Shortcut from the general settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.white_label_kit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="before">
                <block title="Branding" name="white_label_kit_setting_container" groups="base.group_system">
                    <setting string="White Label" help="Make your Odoo look like your company: name, logo, icon and colors. Off until you switch it on.">
                        <button name="%(white_label_kit.action_white_label_dashboard)d" type="action" string="Open the White Label dashboard"
                                class="btn-link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
