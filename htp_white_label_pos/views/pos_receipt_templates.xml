<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 20: the receipt is a server template. “Powered by Odoo” hidden (not removed) when the branding is on -->
    <template id="pos_order_receipt_footer" inherit_id="point_of_sale.pos_order_receipt_footer" name="White Label: receipt footer">
        <xpath expr="//div[@name='footer']/../div[strong]" position="attributes">
            <attribute name="t-if">not env['white.label.config'].sudo()._brand_data().get('active')</attribute>
        </xpath>
        <xpath expr="//div[@name='footer']/../div[strong]" position="after">
            <t t-set="wl_brand" t-value="env['white.label.config'].sudo()._brand_data()"/>
            <div t-if="wl_brand.get('active') and wl_brand.get('powered_by') == 'brand'" class="w-100 text-center mt-3">
                Powered by <strong t-out="wl_brand['name']"/>
            </div>
        </xpath>
    </template>
</odoo>
